[Unit]
Description=Robot HMI Flask Server
After=network.target

[Service]
Type=simple
User=cave
WorkingDirectory=/home/cave/hmi
# RMW must match hmi_bridge.service — app.py's subprocess.Popen children
# (ros2 topic hz, ros2 bag record) need the same DDS implementation.
Environment="ROS_DOMAIN_ID=0"
Environment="RMW_IMPLEMENTATION=rmw_fastrtps_cpp"
ExecStart=/home/cave/hmi/start.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
